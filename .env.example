# Use your own NEW, empty Supabase project. Server-side only.
SUPABASE_URL=
SUPABASE_KEY=
APP_USERNAME=
# At least 16 characters; generate a unique strong password.
APP_PASSWORD=
HOST=127.0.0.1
PORT=5000
# Public HTTPS origin if deployed behind a reverse proxy.
APP_ORIGIN=
# Optional AI scoring. Leave blank to disable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Optional path to your own plain-text resume, e.g. private/resume.txt.
RESUME_FILE=

# ── Optional automation (automation/*.py) ─────────────────────────────
# Where the scripts reach your tracker. Defaults to http://127.0.0.1:$PORT.
TRACKER_URL=
# Gmail sync: your own Gmail address and a Google app password
# (https://myaccount.google.com/apppasswords; requires 2-Step Verification).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_LOOKBACK_DAYS=2
# Comma-separated regexes for senders/subjects Gmail sync should ignore.
GMAIL_IGNORE_SENDERS=
GMAIL_IGNORE_SUBJECTS=
# Optional webhook for run summaries (Slack/Discord/ntfy-compatible JSON).
NOTIFY_WEBHOOK_URL=
# Logs and daily reports. Defaults to ./automation-data (Git-ignored).
AUTOMATION_DATA_DIR=
